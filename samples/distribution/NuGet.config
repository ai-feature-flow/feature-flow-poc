<?xml version="1.0" encoding="utf-8"?>
<!-- The engine's packages come from the local folder feed only (dotnet pack FeatureFlow.slnx -c Release -o artifacts/packages,
     from the repository root); everything else from nuget.org. Nothing is published to any feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="FeatureFlow.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
