diff --git a/tests/FeatureFlow.Example.Api.UnitTests/WidgetCreatedAtTests.cs b/tests/FeatureFlow.Example.Api.UnitTests/WidgetCreatedAtTests.cs
new file mode 100644
index 0000000..f897794
--- /dev/null
+++ b/tests/FeatureFlow.Example.Api.UnitTests/WidgetCreatedAtTests.cs
@@ -0,0 +1,20 @@
+using FeatureFlow.Example.Api;
+using Xunit;
+
+namespace FeatureFlow.Example.Api.UnitTests;
+
+[Trait("Category", "unit")]
+public sealed class WidgetCreatedAtTests
+{
+    [Fact]
+    public void Add_sets_CreatedAt_within_a_second_of_now()
+    {
+        var store = new WidgetStore();
+
+        var before = DateTimeOffset.UtcNow;
+        var widget = store.Add("alpha");
+        var after = DateTimeOffset.UtcNow;
+
+        Assert.InRange(widget.CreatedAt, before.AddSeconds(-1), after.AddSeconds(1));
+    }
+}
diff --git a/tests/FeatureFlow.Example.Api.UnitTests/WidgetFindByNameTests.cs b/tests/FeatureFlow.Example.Api.UnitTests/WidgetFindByNameTests.cs
new file mode 100644
index 0000000..acbd259
--- /dev/null
+++ b/tests/FeatureFlow.Example.Api.UnitTests/WidgetFindByNameTests.cs
@@ -0,0 +1,30 @@
+using FeatureFlow.Example.Api;
+using Xunit;
+
+namespace FeatureFlow.Example.Api.UnitTests;
+
+[Trait("Category", "unit")]
+public sealed class WidgetFindByNameTests
+{
+    [Fact]
+    public void FindByName_returns_widget_with_exact_name()
+    {
+        var store = new WidgetStore();
+        var added = store.Add("alpha");
+
+        var found = store.FindByName("alpha");
+
+        Assert.Same(added, found);
+    }
+
+    [Fact]
+    public void FindByName_is_case_sensitive_and_returns_null_for_different_case()
+    {
+        var store = new WidgetStore();
+        store.Add("alpha");
+
+        var found = store.FindByName("ALPHA");
+
+        Assert.Null(found);
+    }
+}
