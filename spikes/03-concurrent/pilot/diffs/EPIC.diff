+++ b/tests/FeatureFlow.Example.Api.UnitTests/WidgetFindByNameTests.cs
@@ -0,0 +1,23 @@
+using FeatureFlow.Example.Api;
+using Xunit;
+
+namespace FeatureFlow.Example.Api.UnitTests;
+
+public class WidgetFindByNameTests
+{
+    [Fact]
+    public void FindByName_returns_the_widget_with_that_name()
+    {
+        var store = new WidgetStore();
+        var added = store.Add("alpha");
+        Assert.Equal(added, store.FindByName("alpha"));
+    }
+
+    [Fact]
+    public void FindByName_is_case_sensitive()
+    {
+        var store = new WidgetStore();
+        store.Add("alpha");
+        Assert.Null(store.FindByName("ALPHA"));
+    }
+}
