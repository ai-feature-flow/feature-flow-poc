+using FeatureFlow.Example.Api;
+using Xunit;
+
+namespace FeatureFlow.Example.Api.UnitTests;
+
+public class WidgetCreatedAtTests
+{
+    [Fact]
+    public void Add_records_the_creation_time()
+    {
+        var before = DateTimeOffset.UtcNow;
+        var widget = new WidgetStore().Add("alpha");
+        Assert.InRange(widget.CreatedAt, before, DateTimeOffset.UtcNow);
+    }
+}
