<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeatureFlow.Api.Contracts\FeatureFlow.Api.Contracts.csproj" />
    <ProjectReference Include="..\FeatureFlow.Interpreter\FeatureFlow.Interpreter.csproj" />
    <ProjectReference Include="..\FeatureFlow.Providers.Abstractions\FeatureFlow.Providers.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Temporalio" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>

  <!-- The console (src/FeatureFlow.Console, LOG 453): built with Node and Vite by npm, then embedded as console/<path>
       and served at /console (ApiApp.Console.cs, LOG 454). Each step runs only when its inputs changed. Node is required;
       -p:ConsoleBuild=false skips npm and embeds whatever dist/ already holds, which the image build uses (LOG 462). -->
  <PropertyGroup>
    <ConsoleDir>$(MSBuildThisFileDirectory)..\FeatureFlow.Console\</ConsoleDir>
    <ConsoleBuild Condition="'$(ConsoleBuild)' == ''">true</ConsoleBuild>
  </PropertyGroup>

  <ItemGroup>
    <ConsoleInput Include="$(ConsoleDir)src\**\*;$(ConsoleDir)scripts\**\*;$(ConsoleDir)index.html;$(ConsoleDir)vite.config.ts;$(ConsoleDir)tsconfig.json;$(ConsoleDir)package.json;$(ConsoleDir)package-lock.json;$(MSBuildThisFileDirectory)openapi.json"
                  Exclude="$(ConsoleDir)src\api\schema.gen.d.ts" />
  </ItemGroup>

  <Target Name="ConsoleNode" Condition="'$(ConsoleBuild)' == 'true'">
    <Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ConsoleNodeExit" />
    </Exec>
    <Error Condition="'$(ConsoleNodeExit)' != '0'"
           Text="The console (src/FeatureFlow.Console) needs Node 22.12 or later and npm on PATH. Install Node, or build without the console: dotnet build -p:ConsoleBuild=false" />
  </Target>

  <Target Name="ConsoleInstall" DependsOnTargets="ConsoleNode" Condition="'$(ConsoleBuild)' == 'true'"
          Inputs="$(ConsoleDir)package.json;$(ConsoleDir)package-lock.json;$(ConsoleDir).npmrc" Outputs="$(ConsoleDir)node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ConsoleDir)" />
  </Target>

  <!-- Inputs and outputs see a changed file, not a deleted one, so the list of inputs is an input too: it is rewritten,
       and so newer than dist/, only when a file is added, renamed or deleted. -->
  <Target Name="ConsoleInputList" Condition="'$(ConsoleBuild)' == 'true'">
    <WriteLinesToFile File="$(IntermediateOutputPath)console.inputs" Lines="@(ConsoleInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="ConsoleCompile" DependsOnTargets="ConsoleInstall;ConsoleInputList" Condition="'$(ConsoleBuild)' == 'true'"
          Inputs="@(ConsoleInput);$(IntermediateOutputPath)console.inputs" Outputs="$(ConsoleDir)dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(ConsoleDir)" />
  </Target>

  <!-- A target, not a static item: dist/ is globbed after it is built. -->
  <Target Name="ConsoleEmbed" DependsOnTargets="ConsoleCompile" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ConsoleFile Include="$(ConsoleDir)dist\**\*" />
      <EmbeddedResource Include="@(ConsoleFile)" LogicalName="console/%(ConsoleFile.RecursiveDir)%(ConsoleFile.Filename)%(ConsoleFile.Extension)"
                        WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

</Project>
